APP_NAME=GoldStreet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/El_Salvador
APP_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goldstreet
DB_USERNAME=root
DB_PASSWORD=
# Ruta de mysqldump para `php artisan backup:db` (vacío = XAMPP o el del PATH)
DB_DUMP_BINARY=

# Sesiones y caché en archivos: el proyecto no crea tablas sessions/cache
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
